# --- OpenRouter (https://openrouter.ai/keys) ---
# Copia este archivo a ".env" y rellena tu clave. NO subas ".env" al repo.

# Obligatorio: tu API key de OpenRouter (empieza por "sk-or-...")
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

OPENROUTER_MODEL=

# Opcional: identifican tu app en los rankings de OpenRouter
OPENROUTER_SITE_URL=http://localhost:4200
OPENROUTER_SITE_NAME=AnimoSpace

# Opcional: puerto del servidor SSR de producción (por defecto 4000)
# PORT=4000
