{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/animospace/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.mjs"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/animospace/**",
      "maxDuration": 25
    }
  },
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular"
}